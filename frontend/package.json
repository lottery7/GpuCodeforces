{
  "name": "gpu-forces-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../docs/frontend/openapi.yaml -o src/api/schema.d.ts",
    "dev": "pnpm generate:api && vite",
    "build": "pnpm generate:api && tsc -b && vite build",
    "typecheck": "pnpm generate:api && tsc -b",
    "test": "pnpm generate:api && vitest run",
    "test:watch": "pnpm generate:api && vitest",
    "preview": "vite preview",
    "api:demo": "node tests/fixtures/api-server.mjs",
    "dev:demo": "pnpm generate:api && vite --mode demo"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/view": "6.43.15",
    "@tanstack/react-query": "5.107.1",
    "@uiw/react-codemirror": "4.25.12",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
