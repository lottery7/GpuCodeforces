# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/gpuproblems
DB_USERNAME=gpu
DB_PASSWORD=gpu

# --- Server ---
PORT=8080

# --- Problems Git repository ---
# Must be a reachable git repository URL, e.g. https or git@...
PROBLEMS_GIT_URL=https://github.com/lottery7/GpuCodeforcesProblems
# Branch to sync (default: main)
PROBLEMS_GIT_BRANCH=main
# Local directory where the repo is cloned (default: ./data/problems-repo)
PROBLEMS_GIT_DIRECTORY=./data/problems-repo
# Sub-directory inside the repo containing the problems/ tree (default: problems)
PROBLEMS_DIRECTORY=problems
# If true, runs a sync automatically on application startup (default: false)
PROBLEMS_SYNC_ON_STARTUP=false

# --- Internal endpoints ---
# Optional shared secret. When set, internal endpoints require X-Internal-Key header.
INTERNAL_API_KEY=

# --- GitHub webhook ---
# Secret used to verify the X-Hub-Signature-256 header on the webhook endpoint.
GITHUB_WEBHOOK_SECRET=
